rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function owner() {
      return request.auth != null && request.auth.token.email_verified == true
        && email() in ['admin@gladstonebackpackers.com', 'luke@totalwelding.com.au'];
    }
    function members() {
      return get(/databases/$(database)/documents/access/members).data.members;
    }
    function member() {
      return request.auth != null && (owner() || email() in members());
    }
    function guest() {
      return !owner() && member() && members()[email()].role == 'guest';
    }
    function manager() {
      return owner() || (member() && members()[email()].role == 'manager');
    }

    // Who's on the crew: everyone on it can read, only managers change it
    match /access/members {
      allow read: if member();
      allow write: if manager();
    }
    // Phone call log from the reception phone (live rule holds the real key; not kept in the repo)
    match /calls/{id} {
      allow create: if request.resource.data.key == 'SET_IN_CONSOLE'
        && request.resource.data.keys().hasOnly(['status','number','t','key'])
        && request.resource.data.status in ['answered','missed'];
    }
    // People asking to join: they write their own request, managers see and clear them
    match /requests/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow read, delete: if manager() || (request.auth != null && request.auth.uid == uid);
    }
    // Volunteer calendar and notes: managers only
    match /vols/{id} {
      allow read, write: if manager();
    }
    match /volnotes/{id} {
      allow read, write: if manager();
    }
    // Points and rewards: everyone on the crew can see them, only managers give or use them
    match /credits/{id} {
      allow read: if member();
      allow write: if manager();
    }
    match /rewards/{id} {
      allow read: if member();
      allow write: if manager();
    }
    match /settings/vols {
      allow read: if member();
      allow write: if manager();
    }
    // Feedback: anyone on the crew (guests too) can send it, managers read and clear it
    match /feedback/{id} {
      allow create: if member();
      allow read, delete: if manager();
    }
    // Everything else on the board: crew read and write, guests read only
    match /{col}/{rest=**} {
      allow read: if member() && !(col in ['access', 'requests', 'vols', 'volnotes', 'credits', 'rewards', 'feedback']);
      allow write: if member() && !guest() && !(col in ['access', 'requests', 'vols', 'volnotes', 'credits', 'rewards', 'feedback']);
    }
  }
}
